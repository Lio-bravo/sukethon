<joint name="axis_x" type="prismatic"><parent>base</parent><child>slide_x</child><axis><xyz>1 0 0</xyz><limit><lower>-2</lower><upper>2</upper><effort>3000</effort><velocity>1</velocity></limit><dynamics><damping>5</damping></dynamics></axis></joint>
<joint name="axis_y" type="prismatic"><parent>slide_x</parent><child>slide_y</child><axis><xyz>0 1 0</xyz><limit><lower>-2</lower><upper>2</upper><effort>3000</effort><velocity>1</velocity></limit><dynamics><damping>5</damping></dynamics></axis></joint>
<joint name="axis_z" type="prismatic"><parent>slide_y</parent><child>slide_z</child><axis><xyz>0 0 1</xyz><limit><lower>-1.5</lower><upper>0.7</upper><effort>3000</effort><velocity>1</velocity></limit><dynamics><damping>5</damping></dynamics></axis></joint>
<joint name="axis_yaw" type="revolute"><parent>slide_z</parent><child>tool</child><axis><xyz>0 0 1</xyz><limit><lower>-6.3</lower><upper>6.3</upper><effort>3000</effort><velocity>1</velocity></limit><dynamics><damping>5</damping></dynamics></axis></joint>
